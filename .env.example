# ==============================================================================
# Supabase Configuration for Ticketchai
# Get these credentials from: https://supabase.com/dashboard -> Project Settings -> API
# ==============================================================================

# Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# Project Public Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Secret Key (Server-only for administrative background jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
